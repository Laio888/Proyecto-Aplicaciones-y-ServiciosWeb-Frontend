@page "/premios"
@rendermode InteractiveServer

@using FrontendBlazor_Aplicaciones_y_Servicios_Web.Modelos
@inject PremioService premioService

<h3>Premios</h3>

<p class="text-muted">
    Consulta, edición y eliminación de premios y reconocimientos académicos.
</p>

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary" href="/premios/create">
        Nuevo Premio
    </a>
</div>

@if (premios == null)
{
    <p>Cargando...</p>
}
else if (!premios.Any())
{
    <div class="alert alert-info">
        No hay premios registrados.
    </div>
}
else
{
    <table class="table table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Entidad</th>
                <th>Fecha</th>
                <th>Descripción</th>
                <th style="width: 170px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in premios)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>@p.Nombre</td>
                    <td>@p.EntidadOtorgante</td>
                    <td>@p.Fecha</td>
                    <td>@p.Descripcion</td>
                    <td>
                        <a class="btn btn-warning btn-sm me-1" href="/premios/edit/@p.Id">
                            Editar
                        </a>

                        <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(p.Id)">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Premio> premios = new();

    protected override async Task OnInitializedAsync()
    {
        premios = await premioService.GetAll();
    }

    private async Task Eliminar(int id)
    {
        await premioService.Delete(id);
        premios.RemoveAll(p => p.Id == id);
    }
}