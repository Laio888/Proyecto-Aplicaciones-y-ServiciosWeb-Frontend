@page "/acreditacion"
@rendermode InteractiveServer

@using FrontendBlazor_Aplicaciones_y_Servicios_Web.Modelos
@inject AcreditacionService acreditacionService
@inject ProgramaService programaService

<h3>Acreditación</h3>

<p class="text-muted">
    Consulta, edición y eliminación de acreditaciones asociadas a programas académicos.
</p>

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary" href="/acreditacion/create">
        Nueva Acreditación
    </a>
</div>

@if (acreditaciones == null || programas == null)
{
    <p>Cargando...</p>
}
else if (!acreditaciones.Any())
{
    <div class="alert alert-info">
        No hay acreditaciones registradas.
    </div>
}
else
{
    <table class="table table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Resolución</th>
                <th>Tipo</th>
                <th>Calificación</th>
                <th>Fecha Inicio</th>
                <th>Fecha Fin</th>
                <th>Programa</th>
                <th style="width: 170px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in acreditaciones)
            {
                var programa = programas.FirstOrDefault(p => p.Id == a.Programa);

                <tr>
                    <td>@a.Resolucion</td>
                    <td>@a.Tipo</td>
                    <td>@a.Calificacion</td>
                    <td>@a.FechaInicio</td>
                    <td>@a.FechaFin</td>
                    <td>@(programa?.Nombre ?? "No encontrado")</td>
                    <td>
                        <a class="btn btn-warning btn-sm me-1" href="/acreditacion/edit/@a.Resolucion">
                            Editar
                        </a>

                        <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(a.Resolucion)">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Acreditacion> acreditaciones = new();
    private List<Programa> programas = new();

    protected override async Task OnInitializedAsync()
    {
        acreditaciones = await acreditacionService.GetAll();
        programas = await programaService.GetAll();
    }

    private async Task Eliminar(int resolucion)
    {
        await acreditacionService.Delete(resolucion);
        acreditaciones.RemoveAll(a => a.Resolucion == resolucion);
    }
}