@page "/enfoques"
@rendermode InteractiveServer

@using FrontendBlazor_Aplicaciones_y_Servicios_Web.Modelos
@inject EnfoqueService enfoqueService

<h3>Enfoques</h3>

<p class="text-muted">
    Consulta, edición y eliminación de enfoques pedagógicos y curriculares.
</p>

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary" href="/enfoques/create">
        Nuevo Enfoque
    </a>
</div>

@if (enfoques == null)
{
    <p>Cargando...</p>
}
else if (!enfoques.Any())
{
    <div class="alert alert-info">No hay enfoques registrados.</div>
}
else
{
    <table class="table table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th style="width: 170px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in enfoques)
            {
                <tr>
                    <td>@e.Id</td>
                    <td>@e.Nombre</td>
                    <td>@e.Descripcion</td>
                    <td>
                        <a class="btn btn-warning btn-sm me-1" href="/enfoques/edit/@e.Id">Editar</a>
                        <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(e.Id)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Enfoque> enfoques = new();

    protected override async Task OnInitializedAsync()
    {
        enfoques = await enfoqueService.GetAll();
    }

    private async Task Eliminar(int id)
    {
        await enfoqueService.Delete(id);
        enfoques.RemoveAll(e => e.Id == id);
    }
}