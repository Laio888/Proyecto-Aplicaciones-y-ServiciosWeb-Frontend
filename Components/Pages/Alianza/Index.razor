@page "/alianzas"
@rendermode InteractiveServer

@using FrontendBlazor_Aplicaciones_y_Servicios_Web.Modelos
@inject AlianzaService alianzaService
@inject AliadoService aliadoService
@inject DocenteService docenteService
@inject ProgramaService programaService

<h3>Alianzas</h3>

<p class="text-muted">
    Consulta y eliminación de alianzas entre docentes, programas y aliados.
</p>

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary" href="/alianzas/create">
        Nueva Alianza
    </a>
</div>

@if (alianzas == null || aliados == null || docentes == null || programas == null)
{
    <p>Cargando...</p>
}
else if (!alianzas.Any())
{
    <div class="alert alert-info">
        No hay alianzas registradas.
    </div>
}
else
{
    <table class="table table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Aliado</th>
                <th>Docente</th>
                <th>Programa</th>
                <th style="width: 120px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in alianzas)
            {
                var aliado = aliados.FirstOrDefault(x => x.Nit == a.Aliado);
                var docente = docentes.FirstOrDefault(x => x.Cedula == a.Docente);
                var programa = programas.FirstOrDefault(x => x.Id == a.Departamento);

                <tr>
                    <td>@(aliado?.RazonSocial ?? "No encontrado")</td>
                    <td>@($"{docente?.Nombres} {docente?.Apellidos}")</td>
                    <td>@(programa?.Nombre ?? "No encontrado")</td>
                    <td>
                        <button class="btn btn-danger btn-sm"
                                @onclick="() => Eliminar(a.Aliado, a.Docente, a.Departamento)">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Alianza> alianzas = new();
    private List<Aliado> aliados = new();
    private List<Docente> docentes = new();
    private List<Programa> programas = new();

    protected override async Task OnInitializedAsync()
    {
        alianzas = await alianzaService.GetAll();
        aliados = await aliadoService.GetAll();
        docentes = await docenteService.GetAll();
        programas = await programaService.GetAll();
    }

    private async Task Eliminar(int aliadoId, int docenteId, int programaId)
    {
        await alianzaService.Delete(aliadoId, docenteId, programaId);

        alianzas.RemoveAll(a =>
            a.Aliado == aliadoId &&
            a.Docente == docenteId &&
            a.Departamento == programaId);
    }
}