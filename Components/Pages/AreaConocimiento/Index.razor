@page "/areaconocimiento"
@rendermode InteractiveServer

@using FrontendBlazor_Aplicaciones_y_Servicios_Web.Modelos
@inject AreaConocimientoService areaConocimientoService

<h3>Áreas de Conocimiento</h3>

<p class="text-muted">
    Consulta, edición y eliminación de áreas de conocimiento.
</p>

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary" href="/areaconocimiento/create">
        Nueva Área
    </a>
</div>

@if (areas == null)
{
    <p>Cargando...</p>
}
else if (!areas.Any())
{
    <div class="alert alert-info">No hay áreas registradas.</div>
}
else
{
    <table class="table table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Gran Área</th>
                <th>Área</th>
                <th>Disciplina</th>
                <th style="width: 170px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in areas)
            {
                <tr>
                    <td>@a.Id</td>
                    <td>@a.GranArea</td>
                    <td>@a.Area</td>
                    <td>@a.Disciplina</td>
                    <td>
                        <a class="btn btn-warning btn-sm me-1" href="/areaconocimiento/edit/@a.Id">Editar</a>
                        <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(a.Id)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<AreaConocimiento> areas = new();

    protected override async Task OnInitializedAsync()
    {
        areas = await areaConocimientoService.GetAll();
    }

    private async Task Eliminar(int id)
    {
        await areaConocimientoService.Delete(id);
        areas.RemoveAll(a => a.Id == id);
    }
}