@page "/activAcademica"
@rendermode InteractiveServer

@using FrontendBlazor_Aplicaciones_y_Servicios_Web.Modelos
@inject ActivAcademicaService activAcademicaService
@inject ProgramaService programaService

<h3>Actividad Académica</h3>

<p class="text-muted">
    Consulta, edición y eliminación de actividades académicas asociadas a programas.
</p>

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary" href="/activAcademica/create">
        Nueva Actividad Académica
    </a>
</div>

@if (activAcademica == null || programas == null)
{
    <p>Cargando...</p>
}
else if (!activAcademica.Any())
{
    <div class="alert alert-info">
        No hay actividades académicas registradas.
    </div>
}
else
{
    <table class="table table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Créditos</th>
                <th>Tipo</th>
                <th>Área Formación</th>
                <th>Horas Acomp.</th>
                <th>Horas Indep.</th>
                <th>Idioma</th>
                <th>Espejo</th>
                <th>Programa</th>
                <th style="width: 170px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var f in activAcademica)
            {
                var programa = programas.FirstOrDefault(p => p.Id == f.Disenio);

                <tr>
                    <td>@f.Id</td>
                    <td>@f.Nombre</td>
                    <td>@f.NumCreditos</td>
                    <td>@f.Tipo</td>
                    <td>@f.AreaFormacion</td>
                    <td>@f.H_Acom</td>
                    <td>@f.H_Indep</td>
                    <td>@f.Idioma</td>
                    <td>@(f.Espejo ? "Sí" : "No")</td>
                    <td>@(programa?.Nombre ?? "No encontrado")</td>
                    <td>
                        <a class="btn btn-warning btn-sm me-1" href="/activAcademica/edit/@f.Id">
                            Editar
                        </a>

                        <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(f.Id)">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ActivAcademica> activAcademica = new();
    private List<Programa> programas = new();

    protected override async Task OnInitializedAsync()
    {
        activAcademica = await activAcademicaService.GetAll();
        programas = await programaService.GetAll();
    }

    private async Task Eliminar(int id)
    {
        await activAcademicaService.Delete(id);
        activAcademica.RemoveAll(f => f.Id == id);
    }
}