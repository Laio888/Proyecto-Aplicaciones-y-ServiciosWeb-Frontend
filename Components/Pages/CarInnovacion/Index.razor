@page "/carinnovaciones"
@rendermode InteractiveServer

@using FrontendBlazor_Aplicaciones_y_Servicios_Web.Modelos
@inject CarInnovacionService carInnovacionService

<h3>Características de Innovación</h3>

<p class="text-muted">
    Consulta, edición y eliminación de características de innovación curricular.
</p>

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary" href="/carinnovaciones/create">
        Nueva Característica
    </a>
</div>

@if (caracteristicas == null)
{
    <p>Cargando...</p>
}
else if (!caracteristicas.Any())
{
    <div class="alert alert-info">No hay características registradas.</div>
}
else
{
    <table class="table table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Tipo</th>
                <th style="width: 170px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in caracteristicas)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>@c.Nombre</td>
                    <td>@c.Descripcion</td>
                    <td>@c.Tipo</td>
                    <td>
                        <a class="btn btn-warning btn-sm me-1" href="/carinnovaciones/edit/@c.Id">Editar</a>
                        <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(c.Id)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<CarInnovacion> caracteristicas = new();

    protected override async Task OnInitializedAsync()
    {
        caracteristicas = await carInnovacionService.GetAll();
    }

    private async Task Eliminar(int id)
    {
        await carInnovacionService.Delete(id);
        caracteristicas.RemoveAll(c => c.Id == id);
    }
}