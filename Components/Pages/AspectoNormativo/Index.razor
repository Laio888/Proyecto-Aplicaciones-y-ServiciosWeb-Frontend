@page "/aspectosnormativos"
@rendermode InteractiveServer

@using FrontendBlazor_Aplicaciones_y_Servicios_Web.Modelos
@inject AspectoNormativoService aspectoNormativoService

<h3>Aspectos Normativos</h3>

<p class="text-muted">
    Consulta, edición y eliminación de aspectos normativos.
</p>

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary" href="/aspectosnormativos/create">
        Nuevo Aspecto
    </a>
</div>

@if (aspectos == null)
{
    <p>Cargando...</p>
}
else if (!aspectos.Any())
{
    <div class="alert alert-info">No hay aspectos normativos registrados.</div>
}
else
{
    <table class="table table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Tipo</th>
                <th>Descripción</th>
                <th>Fuente</th>
                <th style="width: 170px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in aspectos)
            {
                <tr>
                    <td>@a.Id</td>
                    <td>@a.Tipo</td>
                    <td>@a.Descripcion</td>
                    <td>@a.Fuente</td>
                    <td>
                        <a class="btn btn-warning btn-sm me-1" href="/aspectosnormativos/edit/@a.Id">Editar</a>
                        <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(a.Id)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<AspectoNormativo> aspectos = new();

    protected override async Task OnInitializedAsync()
    {
        aspectos = await aspectoNormativoService.GetAll();
    }

    private async Task Eliminar(int id)
    {
        await aspectoNormativoService.Delete(id);
        aspectos.RemoveAll(a => a.Id == id);
    }
}