@page "/facultades"
@rendermode InteractiveServer

@using FrontendBlazor_Aplicaciones_y_Servicios_Web.Modelos
@inject FacultadService facultadService
@inject UniversidadService universidadService

<h3>Facultades</h3>

<p class="text-muted">
    Consulta, edición y eliminación de facultades académicas.
</p>

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary" href="/facultades/create">
        Nueva Facultad
    </a>
</div>

@if (facultades == null || universidades == null)
{
    <p>Cargando...</p>
}
else if (!facultades.Any())
{
    <div class="alert alert-info">
        No hay facultades registradas.
    </div>
}
else
{
    <table class="table table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Tipo</th>
                <th>Fecha Fundación</th>
                <th>Universidad</th>
                <th style="width: 170px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var f in facultades)
            {
                var uni = universidades.FirstOrDefault(u => u.Id == f.Universidad);

                <tr>
                    <td>@f.Id</td>
                    <td>@f.Nombre</td>
                    <td>@f.Tipo</td>
                    <td>@f.FechaFun.ToShortDateString()</td>
                    <td>@(uni?.Nombre ?? "No encontrada")</td>
                    <td>
                        <a class="btn btn-warning btn-sm me-1" href="/facultades/edit/@f.Id">
                            Editar
                        </a>

                        <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(f.Id)">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Facultad> facultades = new();
    private List<Universidad> universidades = new();

    protected override async Task OnInitializedAsync()
    {
        facultades = await facultadService.GetAll();
        universidades = await universidadService.GetAll();
    }

    private async Task Eliminar(int id)
    {
        await facultadService.Delete(id);
        facultades.RemoveAll(f => f.Id == id);
    }
}