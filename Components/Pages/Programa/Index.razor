@page "/programas"
@rendermode InteractiveServer

@using FrontendBlazor_Aplicaciones_y_Servicios_Web.Modelos
@inject ProgramaService programaService
@inject FacultadService facultadService

<h3>Programas</h3>

<p class="text-muted">
    Consulta, edición y eliminación de programas académicos.
</p>

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary" href="/programas/create">
        Nuevo Programa
    </a>
</div>

@if (programas == null || facultades == null)
{
    <p>Cargando...</p>
}
else if (!programas.Any())
{
    <div class="alert alert-info">
        No hay programas registrados.
    </div>
}
else
{
    <table class="table table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Tipo</th>
                <th>Nivel</th>
                <th>Ciudad</th>
                <th>Facultad</th>
                <th style="width: 170px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in programas)
            {
                var fac = facultades.FirstOrDefault(f => f.Id == p.Facultad);

                <tr>
                    <td>@p.Id</td>
                    <td>@p.Nombre</td>
                    <td>@p.Tipo</td>
                    <td>@p.Nivel</td>
                    <td>@p.Ciudad</td>
                    <td>@(fac?.Nombre ?? "No encontrada")</td>
                    <td>
                        <a class="btn btn-warning btn-sm me-1" href="/programas/edit/@p.Id">
                            Editar
                        </a>

                        <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(p.Id)">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Programa> programas = new();
    private List<Facultad> facultades = new();

    protected override async Task OnInitializedAsync()
    {
        programas = await programaService.GetAll();
        facultades = await facultadService.GetAll();
    }

    private async Task Eliminar(int id)
    {
        await programaService.Delete(id);
        programas.RemoveAll(p => p.Id == id);
    }
}