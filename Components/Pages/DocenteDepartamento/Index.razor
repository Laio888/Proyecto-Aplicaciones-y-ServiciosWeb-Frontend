@page "/docente-departamento"
@rendermode InteractiveServer

@using FrontendBlazor_Aplicaciones_y_Servicios_Web.Modelos
@inject DocenteDepartamentoService docenteDepartamentoService
@inject DocenteService docenteService
@inject ProgramaService programaService

<h3>Docente - Programa</h3>

<p class="text-muted">
    Consulta y eliminación de asociaciones entre docentes y programas académicos.
</p>

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary" href="/docente-departamento/create">
        Nueva Asociación
    </a>
</div>

@if (registros == null || docentes == null || programas == null)
{
    <p>Cargando...</p>
}
else if (!registros.Any())
{
    <div class="alert alert-info">
        No hay asociaciones registradas.
    </div>
}
else
{
    <table class="table table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Docente</th>
                <th>Programa</th>
                <th style="width: 120px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in registros)
            {
                var docente = docentes.FirstOrDefault(d => d.Cedula == r.Docente);
                var programa = programas.FirstOrDefault(p => p.Id == r.Departamento);

                <tr>
                    <td>@($"{docente?.Nombres} {docente?.Apellidos}")</td>
                    <td>@(programa?.Nombre ?? "No encontrado")</td>
                    <td>
                        <button class="btn btn-danger btn-sm"
                                @onclick="() => Eliminar(r.Docente, r.Departamento)">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<DocenteDepartamento> registros = new();
    private List<Docente> docentes = new();
    private List<Programa> programas = new();

    protected override async Task OnInitializedAsync()
    {
        registros = await docenteDepartamentoService.GetAll();
        docentes = await docenteService.GetAll();
        programas = await programaService.GetAll();
    }

    private async Task Eliminar(int docenteId, int programaId)
    {
        await docenteDepartamentoService.Delete(docenteId, programaId);

        registros.RemoveAll(r =>
            r.Docente == docenteId &&
            r.Departamento == programaId);
    }
}