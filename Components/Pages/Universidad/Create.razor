@page "/universidades/create"


@using Microsoft.AspNetCore.Components.Forms
@using FrontendBlazor_Aplicaciones_y_Servicios_Web.Modelos

@inject UniversidadService universidadService
@inject NavigationManager nav
@inject AuthFrontendService AuthService
@inject NavigationManager Navigation

@if (validando)
{
    <p>Validando permisos...</p>
}
else
{
    // aquí va tu formulario actual
}

<h3>Crear Universidad</h3>

<EditForm Model="universidad" OnValidSubmit="Guardar">
    <InputText @bind-Value="universidad.Nombre" placeholder="Nombre" />
    <InputText @bind-Value="universidad.Tipo" placeholder="Tipo" />
    <InputText @bind-Value="universidad.Ciudad" placeholder="Ciudad" />

    <button type="submit">Guardar</button>
</EditForm>

@code {
    private Universidad universidad = new();
    private bool validando = true;
private bool esAdmin;
private string? error;

protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (!firstRender)
        return;

    esAdmin = await AuthService.IsAdminAsync();

    if (!esAdmin)
    {
        Navigation.NavigateTo("/universidades");
        return;
    }

    validando = false;
    StateHasChanged();
}

  private async Task Guardar()
{
    if (!await AuthService.IsAdminAsync())
    {
        Navigation.NavigateTo("/universidades");
        return;
    }

    await universidadService.Create(universidad);
    Navigation.NavigateTo("/universidades");
}
}