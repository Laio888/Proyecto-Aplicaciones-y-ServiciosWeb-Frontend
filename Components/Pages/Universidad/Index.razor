@page "/universidades"

@using FrontendBlazor_Aplicaciones_y_Servicios_Web.Modelos
@inject UniversidadService universidadService
@inject AuthFrontendService AuthService

<h3>Universidades</h3>

@if (esAdmin)
{
    <a href="/universidades/create">Crear nueva</a>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">
        @error
    </div>
}
else if (universidades == null)
{
    <p>Cargando...</p>
}
else if (!universidades.Any())
{
    <p>No hay registros.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Tipo</th>
                <th>Ciudad</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in universidades)
            {
                <tr>
                    <td>@u.Id</td>
                    <td>@u.Nombre</td>
                    <td>@u.Tipo</td>
                    <td>@u.Ciudad</td>
                    <td>
                        @if (esAdmin)
                        {
                            <button @onclick="() => Eliminar(u.Id)">Eliminar</button>
                            <a href="/universidades/edit/@u.Id">Editar</a>
                        }
                        else
                        {
                            <span>Solo lectura</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Universidad>? universidades;
    private string? error;
    private bool esAdmin;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            esAdmin = await AuthService.IsAdminAsync();
            universidades = await universidadService.GetAll();
        }
        catch (Exception ex)
        {
            error = ex.Message;
            universidades = new List<Universidad>();
        }

        StateHasChanged();
    }
    private async Task Eliminar(int id)
    {
        try
        {
            error = null;

            await universidadService.Delete(id);

            universidades?.RemoveAll(u => u.Id == id);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}