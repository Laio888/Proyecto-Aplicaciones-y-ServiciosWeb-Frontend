@page "/universidades"
@rendermode InteractiveServer

@using FrontendBlazor_Aplicaciones_y_Servicios_Web.Modelos
@inject UniversidadService universidadService

<h3>Universidades</h3>

<p class="text-muted">
    Consulta, edición y eliminación de sedes y seccionales universitarias.
</p>

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary" href="/universidades/create">
        Nueva Universidad
    </a>
</div>

@if (universidades == null)
{
    <p>Cargando...</p>
}
else if (!universidades.Any())
{
    <div class="alert alert-info">
        No hay universidades registradas.
    </div>
}
else
{
    <table class="table table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Tipo</th>
                <th>Ciudad</th>
                <th style="width: 170px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in universidades)
            {
                <tr>
                    <td>@u.Id</td>
                    <td>@u.Nombre</td>
                    <td>@u.Tipo</td>
                    <td>@u.Ciudad</td>
                    <td>
                        <a class="btn btn-warning btn-sm me-1" href="/universidades/edit/@u.Id">
                            Editar
                        </a>

                        <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(u.Id)">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Universidad> universidades = new();

    protected override async Task OnInitializedAsync()
    {
        universidades = await universidadService.GetAll();
    }

    private async Task Eliminar(int id)
    {
        await universidadService.Delete(id);
        universidades.RemoveAll(u => u.Id == id);
    }
}