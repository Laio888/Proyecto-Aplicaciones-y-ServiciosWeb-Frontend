@page "/dashboard"
@rendermode InteractiveServer

@using FrontendBlazor_Aplicaciones_y_Servicios_Web.Modelos.Reportes
@inject ReporteService reporteService

<h3 class="mb-2">Dashboard</h3>

<p class="text-muted mb-4">
    Resumen general del módulo de Innovación Curricular.
</p>

@if (dashboard == null)
{
    <p>Cargando información...</p>
}
else
{
    <div class="row g-3">

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Universidades</div>
                    <h2 class="fw-bold mb-0">@dashboard.TotalUniversidades</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Facultades</div>
                    <h2 class="fw-bold mb-0">@dashboard.TotalFacultades</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Programas</div>
                    <h2 class="fw-bold mb-0">@dashboard.TotalProgramas</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Áreas de Conocimiento</div>
                    <h2 class="fw-bold mb-0">@dashboard.TotalAreas</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Docentes</div>
                    <h2 class="fw-bold mb-0">@dashboard.TotalDocentes</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Aliados</div>
                    <h2 class="fw-bold mb-0">@dashboard.TotalAliados</h2>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm border-0 mt-4">
        <div class="card-body">
            <h5>Estado del módulo</h5>
            <p class="text-muted mb-0">
                El módulo cuenta con información cargada para programas, áreas, docentes, aliados y estructuras académicas.
            </p>
        </div>
    </div>
}

@code {
    private DashboardResumen? dashboard;

    protected override async Task OnInitializedAsync()
    {
        dashboard = await reporteService.Dashboard();
    }
}