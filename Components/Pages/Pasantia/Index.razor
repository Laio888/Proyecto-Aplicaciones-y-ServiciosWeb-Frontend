@page "/pasantias"
@rendermode InteractiveServer

@using FrontendBlazor_Aplicaciones_y_Servicios_Web.Modelos
@inject PasantiaService pasantiaService

<h3>Pasantías</h3>

<p class="text-muted">
    Consulta, edición y eliminación de pasantías internacionales y nacionales.
</p>

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary" href="/pasantias/create">
        Nueva Pasantía
    </a>
</div>

@if (pasantias == null)
{
    <p>Cargando...</p>
}
else if (!pasantias.Any())
{
    <div class="alert alert-info">
        No hay pasantías registradas.
    </div>
}
else
{
    <table class="table table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>País</th>
                <th>Empresa</th>
                <th>Descripción</th>
                <th style="width: 170px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in pasantias)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>@p.Nombre</td>
                    <td>@p.Pais</td>
                    <td>@p.Empresa</td>
                    <td>@p.Descripcion</td>
                    <td>
                        <a class="btn btn-warning btn-sm me-1" href="/pasantias/edit/@p.Id">
                            Editar
                        </a>

                        <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(p.Id)">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Pasantia> pasantias = new();

    protected override async Task OnInitializedAsync()
    {
        pasantias = await pasantiaService.GetAll();
    }

    private async Task Eliminar(int id)
    {
        await pasantiaService.Delete(id);
        pasantias.RemoveAll(p => p.Id == id);
    }
}