@page "/practicasestrategias"
@rendermode InteractiveServer

@using FrontendBlazor_Aplicaciones_y_Servicios_Web.Modelos
@inject PracticaEstrategiaService practicaEstrategiaService

<h3>Prácticas / Estrategias</h3>

<p class="text-muted">
    Consulta, edición y eliminación de prácticas y estrategias pedagógicas.
</p>

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary" href="/practicasestrategias/create">
        Nueva Práctica
    </a>
</div>

@if (practicas == null)
{
    <p>Cargando...</p>
}
else if (!practicas.Any())
{
    <div class="alert alert-info">No hay prácticas registradas.</div>
}
else
{
    <table class="table table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Tipo</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th style="width: 170px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in practicas)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>@p.Tipo</td>
                    <td>@p.Nombre</td>
                    <td>@p.Descripcion</td>
                    <td>
                        <a class="btn btn-warning btn-sm me-1" href="/practicasestrategias/edit/@p.Id">Editar</a>
                        <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(p.Id)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<PracticaEstrategia> practicas = new();

    protected override async Task OnInitializedAsync()
    {
        practicas = await practicaEstrategiaService.GetAll();
    }

    private async Task Eliminar(int id)
    {
        await practicaEstrategiaService.Delete(id);
        practicas.RemoveAll(p => p.Id == id);
    }
}