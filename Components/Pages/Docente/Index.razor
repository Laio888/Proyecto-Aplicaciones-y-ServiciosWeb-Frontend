@page "/docentes"
@rendermode InteractiveServer

@using FrontendBlazor_Aplicaciones_y_Servicios_Web.Modelos
@inject DocenteService docenteService

<h3>Docentes</h3>

<p class="text-muted">
    Consulta, edición y eliminación de docentes vinculados al módulo.
</p>

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary" href="/docentes/create">
        Nuevo Docente
    </a>
</div>

@if (docentes == null)
{
    <p>Cargando...</p>
}
else if (!docentes.Any())
{
    <div class="alert alert-info">
        No hay docentes registrados.
    </div>
}
else
{
    <table class="table table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Cédula</th>
                <th>Nombres</th>
                <th>Apellidos</th>
                <th>Género</th>
                <th>Cargo</th>
                <th>Correo</th>
                <th>Teléfono</th>
                <th style="width: 170px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in docentes)
            {
                <tr>
                    <td>@d.Cedula</td>
                    <td>@d.Nombres</td>
                    <td>@d.Apellidos</td>
                    <td>@d.Genero</td>
                    <td>@d.Cargo</td>
                    <td>@d.Correo</td>
                    <td>@d.Telefono</td>
                    <td>
                        <a class="btn btn-warning btn-sm me-1" href="/docentes/edit/@d.Cedula">
                            Editar
                        </a>

                        <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(d.Cedula)">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Docente> docentes = new();

    protected override async Task OnInitializedAsync()
    {
        docentes = await docenteService.GetAll();
    }

    private async Task Eliminar(int cedula)
    {
        await docenteService.Delete(cedula);
        docentes.RemoveAll(d => d.Cedula == cedula);
    }
}