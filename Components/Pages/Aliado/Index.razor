@page "/aliados"
@rendermode InteractiveServer

@using FrontendBlazor_Aplicaciones_y_Servicios_Web.Modelos
@inject AliadoService aliadoService

<h3>Aliados</h3>

<p class="text-muted">
    Consulta, edición y eliminación de entidades aliadas vinculadas al módulo.
</p>

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary" href="/aliados/create">
        Nuevo Aliado
    </a>
</div>

@if (aliados == null)
{
    <p>Cargando...</p>
}
else if (!aliados.Any())
{
    <div class="alert alert-info">
        No hay aliados registrados.
    </div>
}
else
{
    <table class="table table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>NIT</th>
                <th>Razón Social</th>
                <th>Contacto</th>
                <th>Correo</th>
                <th>Teléfono</th>
                <th>Ciudad</th>
                <th style="width: 170px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in aliados)
            {
                <tr>
                    <td>@a.Nit</td>
                    <td>@a.RazonSocial</td>
                    <td>@a.NombreContacto</td>
                    <td>@a.Correo</td>
                    <td>@a.Telefono</td>
                    <td>@a.Ciudad</td>
                    <td>
                        <a class="btn btn-warning btn-sm me-1" href="/aliados/edit/@a.Nit">
                            Editar
                        </a>

                        <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(a.Nit)">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Aliado> aliados = new();

    protected override async Task OnInitializedAsync()
    {
        aliados = await aliadoService.GetAll();
    }

    private async Task Eliminar(int nit)
    {
        await aliadoService.Delete(nit);
        aliados.RemoveAll(a => a.Nit == nit);
    }
}