@page "/programaci"
@rendermode InteractiveServer

@using FrontendBlazor_Aplicaciones_y_Servicios_Web.Modelos
@inject ProgramaCiService programaCiService
@inject ProgramaService programaService
@inject CarInnovacionService carInnovacionService

<h3>Programa - Innovación</h3>

<p class="text-muted">
    Consulta y eliminación de características de innovación asociadas a programas.
</p>

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary" href="/programaci/create">
        Nueva Asociación
    </a>
</div>

@if (registros == null || programas == null || innovaciones == null)
{
    <p>Cargando...</p>
}
else if (!registros.Any())
{
    <div class="alert alert-info">
        No hay asociaciones registradas.
    </div>
}
else
{
    <table class="table table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Programa</th>
                <th>Característica de Innovación</th>
                <th style="width: 120px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in registros)
            {
                var programa = programas.FirstOrDefault(p => p.Id == r.Programa);
                var innovacion = innovaciones.FirstOrDefault(i => i.Id == r.CarInnovacion);

                <tr>
                    <td>@(programa?.Nombre ?? "No encontrado")</td>
                    <td>@(innovacion?.Nombre ?? "No encontrada")</td>
                    <td>
                        <button class="btn btn-danger btn-sm"
                                @onclick="() => Eliminar(r.Programa, r.CarInnovacion)">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ProgramaCi> registros = new();
    private List<Programa> programas = new();
    private List<CarInnovacion> innovaciones = new();

    protected override async Task OnInitializedAsync()
    {
        registros = await programaCiService.GetAll();
        programas = await programaService.GetAll();
        innovaciones = await carInnovacionService.GetAll();
    }

    private async Task Eliminar(int programaId, int carInnovacionId)
    {
        await programaCiService.Delete(programaId, carInnovacionId);
        registros.RemoveAll(r => r.Programa == programaId && r.CarInnovacion == carInnovacionId);
    }
}