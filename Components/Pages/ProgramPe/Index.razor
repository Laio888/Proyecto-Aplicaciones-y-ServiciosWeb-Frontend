@page "/programape"
@rendermode InteractiveServer

@using FrontendBlazor_Aplicaciones_y_Servicios_Web.Modelos
@inject ProgramaPeService programaPeService
@inject ProgramaService programaService
@inject PracticaEstrategiaService practicaEstrategiaService

<h3>Programa - Prácticas</h3>

<p class="text-muted">
    Consulta y eliminación de prácticas y estrategias asociadas a programas.
</p>

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary" href="/programape/create">
        Nueva Asociación
    </a>
</div>

@if (registros == null || programas == null || practicas == null)
{
    <p>Cargando...</p>
}
else if (!registros.Any())
{
    <div class="alert alert-info">
        No hay asociaciones registradas.
    </div>
}
else
{
    <table class="table table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Programa</th>
                <th>Práctica / Estrategia</th>
                <th style="width: 120px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in registros)
            {
                var programa = programas.FirstOrDefault(p => p.Id == r.Programa);
                var practica = practicas.FirstOrDefault(p => p.Id == r.PracticaEstrategia);

                <tr>
                    <td>@(programa?.Nombre ?? "No encontrado")</td>
                    <td>@(practica?.Nombre ?? "No encontrada")</td>
                    <td>
                        <button class="btn btn-danger btn-sm"
                                @onclick="() => Eliminar(r.Programa, r.PracticaEstrategia)">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ProgramaPe> registros = new();
    private List<Programa> programas = new();
    private List<PracticaEstrategia> practicas = new();

    protected override async Task OnInitializedAsync()
    {
        registros = await programaPeService.GetAll();
        programas = await programaService.GetAll();
        practicas = await practicaEstrategiaService.GetAll();
    }

    private async Task Eliminar(int programaId, int practicaId)
    {
        await programaPeService.Delete(programaId, practicaId);
        registros.RemoveAll(r => r.Programa == programaId && r.PracticaEstrategia == practicaId);
    }
}